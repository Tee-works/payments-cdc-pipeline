# Credentials for the local stack. Nothing real is committed: `make` (or
# scripts/init_env.sh) copies this file to .env, which git ignores, and replaces
# every change-me with a random value. docker compose reads .env directly.
#
# Names match what cdc.config.Settings reads, so the same file drives the
# containers, the connectors and the tests run from the host.

MYSQL_ROOT_PASSWORD=change-me
# Debezium's binlog replication user (created by mysql/init/02_users.sh).
MYSQL_DEBEZIUM_PASSWORD=change-me
# Application user that writes payments (user "app").
MYSQL_PASSWORD=change-me

PG_USER=warehouse
PG_PASSWORD=change-me
