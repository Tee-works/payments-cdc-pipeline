{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "mysql",
  "database.port": "3306",
  "database.user": "debezium",
  "database.password": "${env:MYSQL_DEBEZIUM_PASSWORD}",
  "database.server.id": "184054",
  "topic.prefix": "gateway",
  "database.include.list": "payments",
  "table.include.list": "payments.merchants,payments.transactions,payments.refunds",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "schema-history.payments",
  "include.schema.changes": "false",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "true",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "3"
}
